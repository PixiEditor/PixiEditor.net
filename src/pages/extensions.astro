---
import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";
import InlineMarkdown from "./../components/InlineMarkdown.astro"

const extensions = await getCollection("extensions");

const layoutResponse = await fetch("https://cdn.pixilabs.eu/items-layout.json");

const layout = await layoutResponse.json();

const extensionsById = new Map(
    extensions.map((extension) => [extension.data.Id, extension]),
);

const highlighted = layout.HighlightedExtensions.map((highlight) => ({
    ...highlight,
    extension: extensionsById.get(highlight.ExtensionId),
})).filter((highlight) => highlight.extension);

const featured = layout.FeaturedExtensionIds.map((id) =>
    extensionsById.get(id),
).filter(Boolean);

const featuredIds = new Set(layout.FeaturedExtensionIds);
const highlightedIds = new Set(
    layout.HighlightedExtensions.map((highlight) => highlight.ExtensionId),
);

const allExtensions = extensions.filter(
    (extension) =>
        !featuredIds.has(extension.data.Id) &&
        !highlightedIds.has(extension.data.Id),
);

const getBundlePrice = (item) => {
    const itemsPrice = item.IncludedExtensions.reduce((total, bundleItem) => {
        const extension = extensionsById.get(bundleItem);

        return total + (extension?.data.Price ?? 0);
    }, 0);

    return itemsPrice * (1 - item.PercentageDiscount / 100);
};
---

<Layout title="Extensions" description="Explore extensions for PixiEditor.">
    <main class="max-w-5xl mx-auto px-4 py-12">
        <div class="space-y-7">
            <header class="space-y-1">
                <h1 class="text-2xl font-bold">
                    Build your perfect setup with Extensions
                </h1>

                <p class="text-sm text-neutral-400">
                    PixiEditor is free and always will be. Extensions are how we
                    keep it that way.
                </p>
            </header>

            {
                highlighted.length > 0 && (
                    <section>
                        <div class="mb-2 text-sm uppercase text-neutral-500">
                            Bundles
                        </div>

                        <div class="space-y-3">
                            {highlighted.map((item) => (
                                <a
                                    href={`/extensions/${item.extension.data.Id}`}
                                    class="group flex min-h-[180px] overflow-hidden rounded-xl border border-neutral-800 bg-neutral-900/70 transition-colors hover:border-neutral-600"
                                >
                                    {item.extension.data.ImageUrl && (
                                        <div class="w-0/5 md:w-3/5 shrink-0 overflow-hidden">
                                            <img
                                                src={item.HighlightImageUrl}
                                                alt=""
                                                class="h-full w-full object-contain"
                                                loading="lazy"
                                            />
                                        </div>
                                    )}

                                    <div class="flex min-w-0 flex-1 flex-col p-5">
                                        {item.HeaderTaglineText && (
                                            <div
                                                class="mb-1 text-sm font-medium"
                                                style={`color: ${item.Color}`}
                                            >
                                                {item.HeaderTaglineText}
                                            </div>
                                        )}

                                        <h2 class="text-lg font-bold">
                                            {item.Header ||
                                                item.extension.data.Name}
                                        </h2>

                                        <p
                                            class="mt-2 text-sm text-neutral-400">
                                            <InlineMarkdown children=
                                                {item.Description ||
                                                    item.extension.data
                                                        .Description}>
                                            </InlineMarkdown>
                                        </p>

                                        <div class="mt-auto flex items-center gap-3 pt-4">
                                            <span
                                                class="price-element text-sm"
                                                data-price-pln={getBundlePrice(
                                                    item.extension.data,
                                                )}
                                            >
                                                <span>
                                                   Loading...
                                                </span>
                                            </span>

                                            {item.DealText && (
                                                <span
                                                    class="text-sm"
                                                    style={`color: ${item.Color}`}
                                                >
                                                    <InlineMarkdown children={item.DealText}/>
                                                </span>
                                            )}
                                        </div>
                                    </div>
                                </a>
                            ))}
                        </div>
                    </section>
                )
            }

            {
                featured.length > 0 && (
                    <section>
                        <div class="mb-2 text-sm uppercase text-neutral-500">
                            Featured
                        </div>

                        <div class="grid grid-cols-1 gap-2 md:grid-cols-2">
                            {featured.map((extension) => (
                                <a
                                    href={`/extensions/${extension.id}`}
                                    class="group flex min-h-[80px] items-center gap-4 rounded-lg border border-neutral-800 bg-neutral-900/50 px-4 py-3 transition-colors hover:border-neutral-600"
                                >
                                    <div class="flex h-12 w-12 shrink-0 items-center justify-center">
                                        {extension.data.ImageUrl ? (
                                            <img
                                                src={extension.data.ImageUrl}
                                                alt=""
                                                class="h-12 w-12 object-contain"
                                                loading="lazy"
                                            />
                                        ) : (
                                            <div class="flex h-12 w-12 items-center justify-center rounded bg-neutral-800 text-neutral-600">
                                                ?
                                            </div>
                                        )}
                                    </div>

                                    <div class="min-w-0 flex-1">
                                        <div class="flex items-center justify-between gap-3">
                                            <h2 class="truncate text-base font-bold">
                                                {extension.data.Name}
                                                <span class="ml-1 text-sm text-neutral-500">
                                                    ↗
                                                </span>
                                            </h2>

                                            <span
                                                class="price-element shrink-0 text-sm text-neutral-300"
                                                data-price-pln={
                                                    extension.data.Price
                                                }
                                            >
                                                <span>
                                                    Loading...
                                                </span>
                                            </span>
                                        </div>

                                        <p class="mt-1 line-clamp-2 text-sm text-neutral-400">
                                            {extension.data.Description}
                                        </p>
                                    </div>
                                </a>
                            ))}
                        </div>
                    </section>
                )
            }

            <section>
                <div class="mb-2 text-sm uppercase text-neutral-500">
                    Extensions
                </div>

                <div class="grid grid-cols-1 gap-2 md:grid-cols-2">
                    {
                        allExtensions.map((extension) => (
                            <a
                                href={`/extensions/${extension.id}`}
                                class="group flex min-h-[80px] items-center gap-4 rounded-lg border border-neutral-800 bg-neutral-900/50 px-4 py-3 transition-colors hover:border-neutral-600"
                            >
                                <div class="flex h-12 w-12 shrink-0 items-center justify-center">
                                    {extension.data.ImageUrl ? (
                                        <img
                                            src={extension.data.ImageUrl}
                                            alt=""
                                            class="h-12 w-12 object-contain"
                                            loading="lazy"
                                        />
                                    ) : (
                                        <div class="flex h-12 w-12 items-center justify-center rounded bg-neutral-800 text-neutral-600">
                                            ?
                                        </div>
                                    )}
                                </div>

                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center justify-between gap-3">
                                        <h2 class="truncate text-base font-bold">
                                            {extension.data.Name}
                                            <span class="ml-1 text-sm text-neutral-500">
                                                ↗
                                            </span>
                                        </h2>

                                        <span
                                            class="price-element shrink-0 text-sm text-neutral-300"
                                            data-price-pln={
                                                extension.data.Price
                                            }
                                        >
                                            <span>
                                                Loading...
                                            </span>
                                        </span>
                                    </div>

                                    <p class="mt-1 line-clamp-2 text-sm text-neutral-400">
                                        {extension.data.Description}
                                    </p>
                                </div>
                            </a>
                        ))
                    }
                </div>
            </section>

            <p class="pt-1 text-center text-sm text-neutral-500">
                <span style="margin-right: 5px;"
                    >Looking for more extensions?</span
                >
                <a
                    href="https://forum.pixieditor.net/t/extension-browser-beta/567"
                    class="underline transition-colors hover:text-neutral-300"
                >
                    Read more about the Extension Browser
                </a>
            </p>
        </div>
    </main>
</Layout>

<script>
    import { updatePrices } from "../utils/price-updater";

    await updatePrices();
</script>
