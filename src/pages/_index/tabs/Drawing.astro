---
import Lucide from "@components/Lucide.astro";
import type { IndexTabData } from "./TabData";
import HlsVideo from "@components/HlsVideo.astro";

export const data: IndexTabData = {
    order: 3,
    id: "drawing",
    title: "Drawing",
    backgroundClass: "bg-pc-drawing-yellow",
    textClass: "text-pc-drawing-yellow",
    iconType: Lucide,
    icon: "brush"
}
---

<h1 class="text-2xl font-bold text-center"><span class="text-pc-drawing-yellow">Draw</span> in any style with a node-based Brush Engine</span></h1>

<HlsVideo class="w-full my-4 mx-auto rounded" width="682" height="384" loop srcPlaylist="/videos/Drawing/Drawing.m3u8" fallbackVideo="/videos/Drawing.webm" />

<p class="text-center">
    Build your own advanced brushes using the <strong>Node Graph</strong>. Sample layers, use custom shaders and more. Start from scratch or tweak the built-in ones.
</p>