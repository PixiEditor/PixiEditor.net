---
import Chip from "@components/Chip.astro";
import RoadmapItem from "./RoadmapItem.astro";
import type { Topic, Proposal } from "@components/ForumData";
import ProposalItem, { StatusVariant } from "@components/ProposalItem.astro";

const FORUM_BASE = "https://forum.pixieditor.net";
const CATEGORY_ID = 22;

let topics: Topic[] = [];
if (import.meta.env.DEV) {
    // Mock data for development
    for (let i = 1; i <= 5; i++) {
        topics.push({
            id: i,
            slug: `mock-proposal-${i}`,
            title: `Mock Proposal ${i}`,
            vote_count: Math.floor(Math.random() * 100),
            post_stream: {
                posts: [
                    {
                        cooked:
                            i % 2 == 0
                                ? `<p><code>${["accepted", "rejected", "more-info-needed", "open-for-discussion"][i % 4]}</code><br>Discussion ends: <code>2026-04-17</code><br><code>2.2</code></p>`
                                : `<p><code>${["accepted", "rejected", "more-info-needed", "open-for-discussion"][i % 4]}</code><br>Discussion ends: <code>2026-04-17</code></p>`,
                        username: "flabbet",
                    },
                ],
            },
        });
    }
} else {
    const categoryRes = await fetch(`${FORUM_BASE}/c/${CATEGORY_ID}.json`);
    console.log(`${FORUM_BASE}/c/${CATEGORY_ID}.json`);
    const categoryData = await categoryRes.json();

    topics = categoryData?.topic_list?.topics || [];
}

async function fetchDiscourseJson<T>(url: string): Promise<T> {
    for (let attempt = 0; attempt < 5; attempt++) {
        const response = await fetch(url);

        if (response.ok) {
            const contentType = response.headers.get("content-type") ?? "";

            if (!contentType.includes("application/json")) {
                const body = await response.text();

                throw new Error(
                    `Discourse returned non-JSON (${response.status}): ${body.slice(0, 200)}`,
                );
            }

            return (await response.json()) as T;
        }

        if (
            response.status === 429 ||
            response.status === 500 ||
            response.status === 502 ||
            response.status === 503 ||
            response.status === 504
        ) {
            const retryAfter = response.headers.get("retry-after");
            const delay = retryAfter
                ? Number(retryAfter) * 1000
                : 1000 * 2 ** attempt;

            console.warn(
                `Discourse ${response.status}, retrying in ${delay}ms: ${url}`,
            );

            await new Promise((resolve) => setTimeout(resolve, delay));
            continue;
        }

        const body = await response.text();

        throw new Error(
            `Discourse request failed (${response.status}): ${body.slice(0, 200)}`,
        );
    }

    throw new Error(`Discourse request failed after retries: ${url}`);
}

const proposals: (Proposal | null)[] = [];

for (const topic of topics) {
    let topicData;

    if (import.meta.env.DEV) {
        topicData = topic;
    } else {
        const topicRes = await fetchDiscourseJson<TopicData>(
            `${FORUM_BASE}/t/${topic.slug}/${topic.id}.json`,
        );

        topicData = topicRes;
    }

    const votingPost = topicData.post_stream.posts.find(
        (p: { cooked: string; username: string }) =>
            p.cooked.includes("Discussion ends:") && p.username == "flabbet",
    );

    if (!votingPost) {
        proposals.push(null);
        continue;
    }

    const codeElements =
        votingPost.cooked
            .match(/<code>(.*?)<\/code>/g)
            ?.map((code: string) => code.replace(/<\/?code>/g, "").trim()) ??
        [];

    let status = "Unknown";
    let forVersion = null;

    if (codeElements.length >= 1) {
        status = codeElements[0];

        if (codeElements.length >= 3) {
            forVersion = codeElements[2];
        }
    }

    proposals.push({
        id: topic.id,
        title: topic.title,
        url: `${FORUM_BASE}/t/${topic.slug}/${topic.id}`,
        votes: topic.vote_count ?? 0,
        status,
        forVersion,
    });
}

const filteredProposals = proposals.filter(
    (p): p is Proposal =>
        p !== null &&
        p.status in StatusVariant &&
        p.status != "rejected" &&
        (p.forVersion === "2.2" ||
            p.forVersion === "2.1" ||
            p.forVersion === null),
);
---

<div class="overflow-auto max-md:pb-3">
    <div class="flex w-fit gap-6 px-8 mx-auto">
        <div class="card max-h-[600px] overflow-y-auto">
            <h3>PixiEditor 2.1</h3>
            <Chip linkTo="/blog/2025/12/10/21-beta" variant="green"
                >Status: Released</Chip
            >
            <div class="card-list">
                <RoadmapItem hoverable={false}
                    ><span style="margin-right: 5px;">Brush Engine</span
                    ></RoadmapItem
                >
                <RoadmapItem hoverable={false}
                    ><span style="margin-right: 5px;">Smart Layers</span
                    ></RoadmapItem
                >
                <RoadmapItem hoverable={false}
                    ><span>Customizable Toolsets</span></RoadmapItem
                >
                <RoadmapItem hoverable={false}
                    ><span style="margin-right: 5px;">Brush Tools</span
                    ></RoadmapItem
                >
                <ProposalItem proposals={proposals} forVersion="2.1" />
            </div>
        </div>

        <div class="card max-h-[600px] overflow-y-auto">
            <h3>PixiEditor 2.2</h3>
            <Chip linkTo="https://forum.pixieditor.net/c/proposals/22"
                >Status: Open for proposals</Chip
            >
            <div class="mt-4">
                <ProposalItem proposals={proposals} forVersion="2.2" />
            </div>
        </div>

        <div class="card max-h-[600px] overflow-y-auto">
            <h3>Proposals</h3>
            <Chip linkTo="https://forum.pixieditor.net/c/proposals/22"
                >Click to propose a feature</Chip
            >
            <div class="mt-4">
                <ProposalItem proposals={proposals} forVersion={null} />
            </div>
        </div>
    </div>
</div>

<style>
    @reference "tailwindcss";
    @tailwind utilities;

    .card {
        @apply w-72 bg-neutral-800 p-8 rounded text-lg;
    }

    .card > h3 {
        @apply text-3xl font-bold;
    }

    .card > ul {
        @apply ps-8 mt-2 flex flex-col gap-y-3;
    }

    .card > h3 {
        @apply mb-2;
    }

    .card-list {
        @apply flex flex-col gap-3 mt-4;
    }
</style>
