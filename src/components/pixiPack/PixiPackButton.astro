---
interface Props {
    price: number;
    color: string;
    hover: string;
    productId: string;
    buttonLink?: string;
}

const props = Astro.props;
const { productId } = props; 
---

<a href={props.buttonLink}>
<button data-product-id={productId} class="purchase-button"
    data-price-pln={props.price}
    class:list={[
        "mt-3 w-full rounded py-2 transition cursor-pointer",
        props.color,
        props.hover
    ]}
>
    {!props.buttonLink ? <span>Buy for  <span class="font-semibold">Loading...</span></span> : <span>Get now</span>}
</button>
</a>